# 公開マクロ機能用の環境変数サンプル。`.env.local` にコピーして値を入れる（.env.local は git 管理外）。
# 共有 URL・エディタ本体はこれらがなくても動く。公開マクロ（/macros 以下）だけが使う。

# --- Neon（Postgres） ---
# Neon のダッシュボード > Connection Details > Pooled connection の文字列。
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# --- 共有カード ---
# 共有時の og:image などの絶対 URL の基準（本番ドメイン）。例：https://macro.eocl.me（末尾スラッシュなし）。
# 未設定でも Vercel 上では自動で補われるが、独自ドメインを使うなら明示する。
SITE_URL=

# --- サイト名・既定のメタ情報（すべて任意） ---
# BRAND_NAME はヘッダー・共有カード・各ページの title 末尾に使う。未設定は ff14-macro-helper。
# 公開マクロ詳細の title は「{マクロタイトル} « {BRAND_NAME}」、ほかのページは「{ページ名} | {BRAND_NAME}」になる。
BRAND_NAME=
# トップページの title と、description を持たないページの既定の説明。未設定なら BRAND_NAME / 既定の説明文。
DEFAULT_TITLE=
DEFAULT_DESCRIPTION=

# --- 認証（Auth.js 想定。ライブラリは実装時に確定） ---
# セッション署名用。`openssl rand -base64 32` で生成する。
AUTH_SECRET=

# Discord OAuth。https://discord.com/developers/applications で作成し、
# OAuth2 > Redirects に http://localhost:3000/api/auth/callback/discord（本番はそのドメイン版）を登録する。
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# 管理者（公開停止ができる人）の Discord ユーザー ID。カンマ区切りで複数可。
# Discord の開発者モードを有効にし、自分のアイコンを右クリック > ユーザー ID をコピー。
ADMIN_DISCORD_IDS=

# --- 将来（X OAuth を足す場合のみ。今は空でよい） ---
# AUTH_TWITTER_ID=
# AUTH_TWITTER_SECRET=
