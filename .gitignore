# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# claude code local worktrees/session data
/.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# docs/ のメディアファイル（ローカルに残すだけで、Git には入れない。すでに追跡されているものは対象外）
docs/**/*.svg
docs/**/*.png
docs/**/*.jpg
docs/**/*.jpeg
docs/**/*.gif
docs/**/*.webp
docs/**/*.mp4
docs/**/*.mp3
docs/**/*.wav
docs/**/*.ogg
docs/**/*.flac
docs/**/*.m4a
docs/**/*.m4v
docs/**/*.mov
